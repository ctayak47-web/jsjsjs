rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(uid) {
      return request.auth.uid == uid;
    }
    
    function isProfileOwner() {
      return isOwner(resource.data.uid);
    }

    // Users collection - owners can read, Cloud Functions write
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Profiles collection - public read, owner write
    match /profiles/{uid} {
      allow read: if true;
      allow write: if isOwner(uid) && 
        !request.resource.data.verified &&
        !request.resource.data.keys().hasAny(['starBalance', 'lifetime']);
    }

    // Numbers collection - public read, Cloud Functions write
    match /numbers/{numberId} {
      allow read: if true;
      allow write: if false;
    }

    // Verification codes - Cloud Functions only
    match /verificationCodes/{codeId} {
      allow read: if false;
      allow write: if false;
    }

    // Chats collection - members only
    match /chats/{chatId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.members;
      allow write: if false;
      
      // Messages subcollection
      match /messages/{messageId} {
        allow read: if isSignedIn() && 
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow write: if false;
      }
    }

    // Star balances - owner read only
    match /starBalances/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Star transactions - owner read only
    match /starTransactions/{uid}/transactions/{txId} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Gift inventory - owner read, public browse limited
    match /giftInventory/{uid}/gifts/{inventoryId} {
      allow read: if isOwner(uid) || 
        (resource.data.status == 'listed');
      allow write: if false;
    }

    // Gifts collection - public read
    match /gifts/{giftId} {
      allow read: if true;
      allow write: if false;
    }

    // Market listings - public read, seller manage
    match /marketListings/{listingId} {
      allow read: if true;
      allow write: if false;
    }

    // Trades - participants only
    match /trades/{tradeId} {
      allow read: if isSignedIn() && 
        (request.auth.uid == resource.data.initiator || 
         request.auth.uid == resource.data.responder);
      allow write: if false;
    }

    // Notifications - owner read only
    match /notifications/{uid}/notifications/{notifId} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Countries - public read
    match /countries/{countryCode} {
      allow read: if true;
      allow write: if false;
    }

    // Settings - owner only
    match /settings/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && 
        !request.resource.data.keys().hasAny(['admin', 'verified']);
    }

    // Catch-all - deny everything else
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
